# EDM frontend environment template - copy to .env and fill real values.
# JWT service account used by api-jwt.php to authenticate against edm-api.
EDM_SERVICE_EMAIL=
EDM_SERVICE_PASSWORD=

# Amazon SES (app/Services/Ses/SesConfig.php). Leave the key pair empty to use
# the AWS default credential chain (instance role / ~/.aws/credentials).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
# Configuration set that publishes send / delivery / bounce / complaint / open /
# click events to the SNS topic below (required for reporting). The ses-demo
# setup_ses.py created "alpro-marketing" in ap-southeast-1.
SES_CONFIGURATION_SET=alpro-marketing
# Optional second configuration set for campaigns whose Tracking step turns open
# tracking off: a copy of the one above whose event destination publishes every
# event EXCEPT Open (SES then inserts no tracking pixel). Without it, open
# tracking stays on for every campaign. Click tracking is switched off per
# campaign with ses:no-track on the links and needs no extra set.
SES_CONFIGURATION_SET_NO_OPENS=
# SNS topic subscribed to public/ses-webhook.php; other topics are rejected.
SES_SNS_TOPIC_ARN=
# Optional cap on emails per second (defaults to the account's MaxSendRate).
SES_MAX_SEND_RATE=
# Optional cap on emails per rolling 24 hours, below the SES quota for headroom
# (e.g. 45000 under a 50000/day quota). Defaults to the full SES quota.
SES_DAILY_LIMIT=

# Public base URL of this module (unsubscribe links), no trailing slash,
# e.g. https://odb.example.com/odb/edm
EDM_PUBLIC_URL=
# Random secret that signs unsubscribe links. Generate once per server:
#   php -r "echo bin2hex(random_bytes(32));"
EDM_APP_KEY=

# Synology NAS that stores Files library images (app/Services/Nas/). Images
# reach recipients through public/file.php, which caches them in edm/cache/nas/.
# NAS_HOST: DSM host name (e.g. the QuickConnect direct host), no scheme.
NAS_HOST=
# DSM HTTPS port.
NAS_PORT=5001
NAS_USER=
NAS_PASSWORD=
# Base folder (shared folder path); images go to <NAS_FOLDER>/assets.
NAS_FOLDER=/DigitalInnovation/edm
# TLS certificate check (default true). Set false only for a NAS with a
# self-signed certificate on a trusted network.
NAS_VERIFY_TLS=true

# Google Analytics 4 Data API (newsletter report website figures).
# GA4_PROPERTY_ID: numeric Property ID (GA Admin > Property details), not the
# G-XXXX Measurement ID. The service account must be a Viewer on the property.
GA4_PROPERTY_ID=
# Service account JSON key, base64-encoded on one line, so no key file has to
# be copied to the server. Generate from the downloaded key:
#   powershell -c "[Convert]::ToBase64String([IO.File]::ReadAllBytes('key.json'))"
GA4_CREDENTIALS_JSON=
